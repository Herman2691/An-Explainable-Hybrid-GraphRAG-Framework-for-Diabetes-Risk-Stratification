# Copie ce fichier en ".env" pour un lancement LOCAL (ne pas committer .env).
# Sur Streamlit Cloud, on n'utilise PAS ce fichier : voir secrets.toml.example.

MISTRAL_API_KEY=colle_ta_cle_mistral_ici

# Pour tester en local avec Neo4j Desktop : bolt://localhost:7687
# Pour l'instance en ligne Aura            : neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=mot_de_passe_genere_par_Aura
