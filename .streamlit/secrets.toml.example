# -------------------------------------------------------------------
# MODÈLE de secrets — À COPIER, PAS À COMMITTER LES VRAIES VALEURS
# -------------------------------------------------------------------
# LOCAL : copie ce fichier en ".streamlit/secrets.toml" et remplis-le.
# STREAMLIT CLOUD : ne crée PAS de fichier ; colle ces clés dans
#   "App settings" > "Secrets" via l'interface web.
# -------------------------------------------------------------------

# Clé API Mistral (régénère-la sur console.mistral.ai avant la démo)
MISTRAL_API_KEY = "colle_ta_cle_mistral_ici"

# Neo4j Aura (instance EN LIGNE — l'URI commence par neo4j+s://)
NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "mot_de_passe_genere_par_Aura"
